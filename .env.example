# ===========================================
# Med-AI Assistant — Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medai
DB_USERNAME=medai
DB_PASSWORD=medai_secret

# JWT — IMPORTANT: Generate a unique secret for production!
# Generate with: openssl rand -base64 64
JWT_SECRET=c2VjdXJlLWp3dC1zZWNyZXQtZm9yLW1lZC1haS1hc3Npc3RhbnQtYXBwbGljYXRpb24tMjAyNA==

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Rate Limiting (per tenant)
AI_RATE_LIMIT_RPM=10
AI_RATE_LIMIT_DAILY_USD=50.0

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
