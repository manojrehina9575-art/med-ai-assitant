# ===========================================
# Med-AI Assistant — Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control!

# Database
# Two accounts, on purpose:
#   DB_USERNAME     — the owner/superuser. Used ONLY by Flyway to run migrations.
#   DB_APP_USERNAME — a non-superuser, non-owner role the application connects as at runtime.
# This split is what makes PostgreSQL row-level security apply: a superuser bypasses RLS
# unconditionally, so an app connecting as the owner has no database-level tenant isolation at all,
# no matter what the policies say. V11 creates the app role using DB_APP_PASSWORD.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medai
DB_USERNAME=medai
DB_PASSWORD=medai_secret
DB_APP_USERNAME=medai_app
DB_APP_PASSWORD=medai_app_secret

# JWT — IMPORTANT: Generate a unique secret for production!
# Generate with: openssl rand -base64 64
JWT_SECRET=c2VjdXJlLWp3dC1zZWNyZXQtZm9yLW1lZC1haS1hc3Npc3RhbnQtYXBwbGljYXRpb24tMjAyNA==

# AI Provider (Groq for free tier, or OpenAI)
#
# WARNING: medical images and clinical notes are sent to whichever provider AI_BASE_URL points at.
# A public inference endpoint's standard terms are NOT a HIPAA Business Associate Agreement and NOT
# a DPDP-grade processing agreement. Use synthetic or de-identified data here. For real patient
# data, use a provider that will sign an agreement (Azure OpenAI, AWS Bedrock, Vertex AI) or run a
# self-hosted model, then set AI_DATA_AGREEMENT_IN_PLACE=true to silence the startup warning.
#
# Get a free key at: https://console.groq.com/keys
AI_BASE_URL=https://api.groq.com/openai
# Vision-capable model (handles both text and image analysis)
AI_MODEL=qwen/qwen3.6-27b
GROQ_API_KEY=gsk-your-groq-api-key-here

# Optional: If using OpenAI instead of Groq
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o
# OPENAI_API_KEY=sk-your-openai-key

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set to true only once a data agreement covers the provider above, or it is self-hosted.
AI_DATA_AGREEMENT_IN_PLACE=false

# AI Rate Limiting (per tenant)
AI_RATE_LIMIT_RPM=10
AI_RATE_LIMIT_DAILY_USD=50.0

# Embeddings run locally via ONNX — no API key, no data leaves the server.
EMBEDDING_MODEL_ID=all-MiniLM-L6-v2

# Analysis retry/recovery job
ANALYSIS_REAPER_ENABLED=true
ANALYSIS_REAPER_INTERVAL_MS=60000
ANALYSIS_REAPER_BATCH_SIZE=5
ANALYSIS_REAPER_STALE_MINUTES=10

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
