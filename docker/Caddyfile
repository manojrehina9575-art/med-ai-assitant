# Automatic HTTPS for every hospital's own hostname.
#
# Each tenant reaches the platform at <workspace>.{$BASE_DOMAIN} — lifeline.medaiclinical.com,
# apollo.medaiclinical.com — and app.{$BASE_DOMAIN} is the workspace chooser. One wildcard
# certificate covers all of them, so onboarding a hospital needs no deploy and no new cert: the
# wildcard DNS record already points here and this block already matches.
#
# REQUIRES a DNS-01 challenge. Let's Encrypt does not issue wildcard certificates over HTTP-01,
# so Caddy proves control of the zone by writing a TXT record through the Cloudflare API. That is
# why the image is built from Dockerfile.caddy with the Cloudflare DNS module and why
# CLOUDFLARE_API_TOKEN is required.
#
# REQUIRES the Cloudflare DNS records to be "DNS only" (grey cloud). A proxied record means
# Cloudflare terminates TLS and sees patient data in plaintext. DNS-01 is unaffected by the grey
# cloud — unlike HTTP-01, it never needs an inbound request to reach this host.

# Shared behaviour for every tenant host. Identical for all of them: the tenant is identified by
# the hostname in the browser, not by anything Caddy routes on.
(platform) {
	encode gzip

	# Security headers for the SPA document itself.
	#
	# Spring Security sets CSP and HSTS on responses it serves, but index.html comes from nginx —
	# so without this the page that actually loads the JavaScript had no CSP at all, and the XSS
	# protection added alongside the httpOnly refresh cookie was only half present.
	#
	# connect-src 'self' is correct on every tenant host because the SPA calls a relative /api,
	# so the API is always same-origin with the page that called it.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# API, FHIR facade and health, all to the backend. /fhir is routed explicitly because an EHR
	# or ABDM gateway calls it directly and must not be served the SPA's HTML.
	@backend path /api/* /fhir/* /actuator/health
	handle @backend {
		reverse_proxy backend:8080 {
			# Analyses and uploads outlast Caddy's 30s default. The application caps uploads at
			# 100MB and the model call can take a minute.
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# Everything else is the SPA.
	handle {
		reverse_proxy frontend:80
	}

	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}

# Every tenant, plus the app./staging. infrastructure hosts. A Caddy wildcard matches exactly one
# label, so this covers lifeline.medaiclinical.com but never a.b.medaiclinical.com.
*.{$BASE_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
	import platform
}
