# Build the SPA, then serve the static output with nginx.
#
# This previously ran `vite dev` — the development server — as the production image. That ships
# unminified source with sourcemaps, keeps an HMR websocket open, and holds a Node process using
# roughly 200MB where nginx uses 10. On a 2GB instance that difference is most of your headroom.
FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
# `npm ci` not `npm install`: builds the exact lockfile, and fails loudly if the lockfile and
# package.json disagree rather than quietly resolving something else.
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

# nginx's default config serves /usr/share/nginx/html and 404s on any path that is not a file.
# A React Router app needs every unknown path to return index.html, or a refresh on /worklist
# gives the user a 404 instead of the page they were looking at.
RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # Hashed asset filenames are immutable; index.html must never be cached or a deploy\n\
    # leaves browsers loading a stale bundle that references assets that no longer exist.\n\
    location /assets/ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
\n\
    location = /index.html {\n\
        add_header Cache-Control "no-store, must-revalidate";\n\
    }\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    gzip on;\n\
    gzip_types text/css application/javascript application/json image/svg+xml;\n\
    gzip_min_length 1024;\n\
\n\
    # The container is behind Caddy, which terminates TLS and adds the security headers.\n\
    server_tokens off;\n\
}\n' > /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

# 127.0.0.1, not localhost: inside the container `localhost` resolves to ::1 first, nginx listens
# on IPv4 only, and the probe gets "connection refused" from a container that is serving perfectly
# well. The result is a permanently unhealthy container that orchestrators keep restarting.
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
